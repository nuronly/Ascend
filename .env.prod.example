# ═════════════════════════════════════════════════════════════
#  阶梯 · 生产环境配置
#  cp .env.prod.example .env.prod  然后逐项填写。
#  .env.prod 含密钥，绝不入仓（.gitignore 已排除 .env.*）
# ═════════════════════════════════════════════════════════════

# ── 访问地址 ──
# 有备案域名 → 填域名，Caddy 自动申请 HTTPS 证书
#   SITE_ADDRESS=learn.example.com
# 只有服务器 IP → 填 :80，纯 HTTP 先跑起来（deploy.sh 会自动关掉 Secure cookie）
SITE_ADDRESS=:80
PUBLIC_URL=

APP_ENV=prod
# 域名模式下 deploy.sh 会自动改写成 https://你的域名
CORS_ORIGINS=

# ── ★ 鉴权：必须改 ──
# 生成：openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── ★ 准入控制：公开上线的第一道闸 ──
# 多用户 + 云 API = 别人用你的 key 花你的钱。三选一或叠加：
#   a) 只给自己用  → 注册完账号后把 ALLOW_REGISTRATION 改成 false
#   b) 熟人可用    → 设置 INVITE_CODE
#   c) 小范围公开  → 设置 MAX_USERS 上限
# 参赛/演示场景：让评委能自由注册，但用 MAX_USERS 兜住上限。
# 演示结束后把 ALLOW_REGISTRATION 改成 false 即可。
ALLOW_REGISTRATION=true
INVITE_CODE=
MAX_USERS=50

# ── ★ 速率限制 ──
RATE_LIMIT_ENABLED=true
RATE_AUTH_PER_MINUTE=10
RATE_AI_PER_MINUTE=40

# ── ★ 是否信任反代注入的来源 IP 头（决定限流按谁的 IP 算）──
# 这不是调优项，填错任一方向都会坏事，部署脚本会自动设好，手改务必看清：
#   true  —— 后端在 Nginx / Caddy 之后（install.sh、deploy.sh）。
#            反代会覆写 X-Forwarded-For，可信；不用它则所有人被算成同一个 IP，
#            一个人触发限流就把全站挡在门外。
#   false —— 后端直接对外，uvicorn 自己监听公网端口（deploy-contest.sh）。
#            此时 X-Forwarded-For 由客户端随意伪造，认了就等于让人自选来源 IP：
#            换一个 header 就换一个限流桶，撞库和刷额度的防护全部作废。
TRUST_PROXY_HEADERS=true

# 请求体硬上限（字节，默认 48MB）。反代模式下由 Nginx 的 client_max_body_size
# 兜住；单体部署没有反代，这道闸只能由应用层提供，否则一个超大文件就能把
# 磁盘写满（磁盘满 → SQLite 写不进 → 全站挂）。
# MAX_BODY_BYTES=50331648

# ── 预算闸：单用户每日 token 上限 ──
# 按实测，学完一节课（含大纲摊薄、正文、几张卡）约 1.5~2 万 token。
# 100 万足够一天很重度地用，评委体验绝不会被卡住。
DAILY_TOKEN_QUOTA=1000000

# ── 数据库 ──
DATABASE_URL=sqlite+aiosqlite:////app/data/ladder.db
# 需要多 worker 时切 PostgreSQL：
#   docker compose --profile pg up -d
#   DATABASE_URL=postgresql+asyncpg://ladder:密码@db:5432/ladder
# POSTGRES_PASSWORD=

# ── LLM ──
# 主供应商：DeepSeek 官方平台
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 备用供应商：OpenAI 兼容网关。同时承担 embedding 与生图（官方平台没有这两项）
MAAS_API_KEY=
MAAS_BASE_URL=https://your-gateway.example.com/compatible-mode/v1

MODEL_FLAGSHIP=deepseek:deepseek-v4-pro
MODEL_STANDARD=deepseek:deepseek-v4-pro
MODEL_SMALL=deepseek:deepseek-v4-flash
MODEL_EMBEDDING=maas:qwen3.7-text-embedding
MODEL_IMAGE=maas:qwen-image-2.0-pro
EMBEDDING_DIM=1024
MODEL_OVERRIDES=card_chat=deepseek:deepseek-v4-flash,suggest=deepseek:deepseek-v4-flash,translate=deepseek:deepseek-v4-flash
# 官方平台不可用或余额耗尽时自动接管
MODEL_FALLBACKS=maas:deepseek-v4-pro,maas:qwen3.8-max

LLM_TIMEOUT_SECONDS=180
LLM_FIRST_TOKEN_TIMEOUT=45
LLM_MAX_RETRIES=3

# ── 联网搜索（工具调用）──
# 学习辅助最需要外部信息的两处：大纲阶段核对这个领域公认的知识体系与最新进展，
# 正文阶段给学习者附上权威参考资料（论文原文、官方文档、课程主页）。
#
# 不配 key 也能正常跑 —— 模型压根看不到这个工具，就不会尝试调用它，
# 功能自然降级成纯知识生成，不会报错。
# 免费额度 1000 credits/月，basic 检索 1 credit/次：https://tavily.com
TAVILY_API_KEY=
SEARCH_ENABLED=true
# basic 一次 1 credit；advanced 2 credit 但抓得更深
SEARCH_DEPTH=basic
SEARCH_MAX_RESULTS=5
# tool loop 轮数上限。一轮 = 一次完整的模型往返 + 一次检索，
# 不设上限模型可能反复搜索直到把额度烧光
TOOL_MAX_ROUNDS=3

# ── 意见反馈 ──
# 收件人。反馈一律先落库（feedback 表），邮件只是通知手段，
# 所以 SMTP 不配也不影响功能 —— 管理员可以直接从库里捞。
FEEDBACK_EMAIL=3391442399@qq.com
# QQ 邮箱示例：host=smtp.qq.com  port=465  ssl=true
# ⚠️ SMTP_PASSWORD 填的是「授权码」，不是邮箱登录密码
#    （QQ 邮箱 → 设置 → 账号 → POP3/SMTP 服务 → 生成授权码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
