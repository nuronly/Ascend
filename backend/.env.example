# ─────────────────────────────────────────────────────────────
#  阶梯计划 · 环境配置模板
#  复制为 .env 后填写。.env 绝不入仓（见 PLAN §4.1 密钥防护）
# ─────────────────────────────────────────────────────────────

# ── 应用 ──────────────────────────────────────────────────────
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8788
# 前端地址，用于 CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 鉴权 (PLAN §4.2) ─────────────────────────────────────────
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-secret-please-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# 线上走 HTTPS 时置 true（cookie Secure 标志）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── 数据库 ────────────────────────────────────────────────────
# 现在：SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/ladder.db
# 之后切 Postgres 时只改这一行（并 uv sync --extra postgres）:
# DATABASE_URL=postgresql+asyncpg://ladder:ladder@localhost:5432/ladder

# ── LLM Provider (PLAN §4.1 provider 抽象层) ─────────────────
# 主供应商：任何 OpenAI 兼容的网关都可以（自建 / 云厂商 / 私有 MaaS）
MAAS_API_KEY=
MAAS_BASE_URL=https://your-gateway.example.com/compatible-mode/v1

# 备用供应商：DeepSeek 官方平台（主模型不可用时降级）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 分级路由 (PLAN §4.1) ─────────────────────────────────────
# 知识的生成与解析统一走 DeepSeek —— 中文讲解和结构化输出更稳。
#
# 旗舰：大纲生成 / 第二大脑终答（低频，质量决定整门课与答案的可信度）
MODEL_FLAGSHIP=maas:deepseek-v4-pro
# 中档：小节正文（量大，但正文质量直接决定学习体验，仍用 pro）
MODEL_STANDARD=maas:deepseek-v4-pro
# 小模型：概念抽取 / 打标 / 重排 / 出题判分（结构化小任务）
MODEL_SMALL=maas:deepseek-v4-flash
# 向量：DeepSeek 没有 embedding 模型，这一路只能用千问。
#       1024 维，与 schema 的 vector(1024) 对齐。
MODEL_EMBEDDING=maas:qwen3.7-text-embedding
EMBEDDING_DIM=1024
# 生图（v0.5 勋章）：DeepSeek 无生图能力
MODEL_IMAGE=maas:qwen-image-2.0-pro

# ── 场景级精确覆盖（优先级高于档位）──
# 档位是粗粒度的，但同一档位内不同场景对「质量 vs 延迟」的取舍并不一样：
# 卡片问答是高频交互，用户盯着屏幕等，延迟比质量重要 → 走 flash。
MODEL_OVERRIDES=card_chat=maas:deepseek-v4-flash,suggest=maas:deepseek-v4-flash

# 降级链：主模型报错时按顺序尝试（逗号分隔）
# 先退到 DeepSeek 官方平台，再退到千问 —— 跨供应商才挡得住单点故障
MODEL_FALLBACKS=deepseek:deepseek-chat,maas:qwen3.8-max

# ── 成本与预算闸 (PLAN §4.1 / §4.2) ──────────────────────────
# 单用户每日 token 上限，0 表示不限
DAILY_TOKEN_QUOTA=2000000
LLM_TIMEOUT_SECONDS=180
LLM_FIRST_TOKEN_TIMEOUT=45
LLM_MAX_RETRIES=3
